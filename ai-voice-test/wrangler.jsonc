{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-voice-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-22",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CALL_SESSION",
        "class_name": "CallSession"
      }
    ]
  },
  "exports": {
    "CallSession": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
